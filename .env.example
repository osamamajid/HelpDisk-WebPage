# ==============================================================================
# IT Driver Library - Environment Configuration
# Copy to .env and adjust values. Used by docker-compose and the apps.
# ==============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=itdriver
POSTGRES_PASSWORD=ChangeMeStrongPassword123!
POSTGRES_DB=itdriverlib
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Database URL ----
# Leave EMPTY in Docker: the backend builds a postgresql+asyncpg URL from the
# POSTGRES_* values above. Only set it to point somewhere else, e.g. for local
# development without PostgreSQL:
#   DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=

# ---- FastAPI Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Initial Admin (created on first startup) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_EMAIL=admin@local

# ---- File Storage ----
# Absolute path on the host (used by docker volume) or local dir for dev.
STORAGE_PATH=/app/storage
# Public download base URL (leave empty to derive from request host).
PUBLIC_BASE_URL=
MAX_FILE_SIZE_MB=2048
ALLOWED_EXTENSIONS=.exe,.msi,.zip,.rar,.7z,.iso,.pdf,.txt,.img,.cab,.bin,.msu,.msp,.rar4,.iso

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_URL=http://localhost

# ---- Deployment ----
COMPOSE_PROJECT_NAME=itdriverlib
HTTP_PORT=80
HTTPS_PORT=443
