# Backend base URL as seen from the browser (public UI).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL, used for metadata and absolute links.
NEXT_PUBLIC_BASE_URL=http://localhost

# Backend base URL as seen from the Next.js server (Docker network).
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_INTERNAL_URL=http://backend:8000
